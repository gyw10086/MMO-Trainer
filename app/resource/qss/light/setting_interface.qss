SettingInterface {
    background-color: #F4F5F7;
}

#scrollWidget {
    background-color: transparent;
}

QScrollArea {
    background-color: transparent;
    border: none;
}


QLabel#settingLabel {
    font: 33px 'Microsoft YaHei';
    background-color: transparent;
}

