DraggableItem {
    border: 1px solid rgb(70, 70, 70);
    border-radius: 0px
}

DraggableItem>QLabel {
    font: 14px 'Segoe UI', 'Microsoft YaHei'
}

ItemsDraggableWidget {
    border: 1px solid rgb(70, 70, 70);
    border-radius: 0px;
    background-color: rgba(255, 255, 255, 0.051);
}